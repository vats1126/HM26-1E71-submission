# =============================================================================
# CleanCity — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real credentials.
# The .gitignore already covers .env, .env.local, and .env.*.local.
# =============================================================================

# --- Supabase ---
# Get these from your Supabase project: https://app.supabase.com
# Project Settings > API

# Your Supabase project URL (e.g. https://xyzproject.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public API key (safe for browser usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key for server-side admin operations (keep secret!)
# Uncomment when needed for admin functionality in future milestones.
# SUPABASE_SERVICE_ROLE_KEY=
